---
import { formatDate } from '../../utils/formatDate';
import { calculateReadingTime } from '../../utils/readingTime';
import Tag from '../ui/Tag.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { title, description, date, tags } = post.data;
const readingTime = calculateReadingTime(post.body);
const BASE = (import.meta.env.BASE_URL || '').replace(/\/$/, '');
const postUrl = `${BASE}/posts/${post.slug}/`;
---

<article
  class="group border transition-all duration-300 hover:border-[#A3E635]"
  style={{ backgroundColor: 'var(--bg-surface)', borderColor: 'var(--border-default)' }}
>
  <div class="block p-5 md:p-6">
    <!-- Top row: Date + Reading Time + Tags -->
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-4">
      <div class="flex items-center gap-2">
        <span
          class="font-mono text-[11px] uppercase tracking-wider"
          style={{ color: 'var(--text-secondary)' }}
        >
          {formatDate(date)}
        </span>
        <span class="font-mono text-[10px]" style={{ color: 'var(--border-dim)' }}>
          |
        </span>
        <span
          class="font-mono text-[10px] uppercase tracking-wider"
          style={{ color: 'var(--text-secondary)' }}
        >
          {readingTime}
        </span>
      </div>
      <!-- Tags inline with meta -->
      {
        tags.length > 0 && (
          <div class="hidden md:flex items-center gap-1">
            <span class="font-mono text-[10px] mr-1" style={{ color: 'var(--border-dim)' }}>
              $
            </span>
            {tags.map((tag) => (
              <span
                class="inline-flex items-center font-mono text-[10px] uppercase tracking-wider"
                style={{ color: 'var(--text-secondary)' }}
              >
                <span style={{ color: '#84CC16', opacity: 0.6 }}>[</span>
                <span class="mx-0.5">{tag}</span>
                <span style={{ color: '#84CC16', opacity: 0.6 }}>]</span>
              </span>
            ))}
          </div>
        )
      }
    </div>

    <!-- Title - clickable link -->
    <a href={postUrl} class="block mb-3">
      <h2
        class="font-sans text-xl md:text-2xl font-semibold leading-tight transition-colors group-hover:text-[#84CC16]"
        style={{ color: 'var(--text-primary)' }}
      >
        {title}
      </h2>
    </a>

    <!-- Description - clickable link -->
    <a href={postUrl} class="block mb-5">
      <p class="text-sm leading-relaxed line-clamp-2" style={{ color: 'var(--text-secondary)' }}>
        {description}
      </p>
    </a>

    <!-- Bottom row: Tags (mobile) + READ link -->
    <div class="flex items-center justify-between">
      <div class="flex md:hidden flex-wrap gap-1.5">
        {tags.map((tag) => (
          <Tag tag={tag} href={`${BASE}/tags/${tag}/`} />
        ))}
      </div>

      <div class="flex items-center gap-3 ml-auto">
        <span
          class="font-mono text-[10px] uppercase tracking-wider hidden sm:inline opacity-0 group-hover:opacity-100 transition-opacity"
          style={{ color: 'var(--text-secondary)' }}
        >
          {post.body.length > 1000 ? 'long read' : 'quick read'}
        </span>
        <!-- READ as independent <a> link -->
        <a
          href={postUrl}
          class="read-btn font-mono text-xs px-2 py-1 transition-all duration-200 inline-flex items-center gap-1.5"
          style={{ color: 'var(--text-secondary)', background: 'transparent' }}
        >
          <span style={{ color: '#84CC16', opacity: 0.6 }}>[</span>
          <span class="uppercase tracking-wider">read</span>
          <span>&rarr;</span>
          <span style={{ color: '#84CC16', opacity: 0.6 }}>]</span>
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  /* Hover: READ text turns lime green */
  article:hover .read-btn {
    color: #a3e635;
  }
  article:hover .read-btn span:first-child,
  article:hover .read-btn span:last-child {
    color: #a3e635;
    opacity: 1;
  }
</style>
