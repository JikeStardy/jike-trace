---
import { SITE } from '../../consts';
const BASE = (import.meta.env.BASE_URL || '').replace(/\/$/, '');
---
<footer class="border-t mt-auto" style={{ borderColor: 'var(--border-default)' }}>
  <div class="max-w-6xl mx-auto px-4 md:px-8 py-6">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2 font-mono text-xs" style={{ color: 'var(--text-secondary)' }}>
        <span>&copy; {new Date().getFullYear()} {SITE.author}</span>
        <span class="hidden md:inline">|</span>
        <span class="hidden md:inline-flex items-center gap-1">Built with <span style={{ color: '#A3E635' }}>&#9829;</span> Astro</span>
      </div>
      <div class="flex items-center gap-3">
        <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="p-2 border transition-all duration-200 hover:bg-[#A3E635] hover:text-[#0A0A0A]" style={{ borderColor: 'var(--border-default)' }} aria-label="GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        </a>
        <a href={`${BASE}/feed.xml`} target="_blank" class="p-2 border transition-all duration-200 hover:bg-[#A3E635] hover:text-[#0A0A0A]" style={{ borderColor: 'var(--border-default)' }} aria-label="RSS Feed">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
