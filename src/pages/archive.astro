---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { formatYearMonth } from '../utils/formatDate';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const tagCount: Record<string, number> = {};
posts.forEach((p) => p.data.tags.forEach((t) => tagCount[t] = (tagCount[t] || 0) + 1));
const allTags = Object.entries(tagCount).sort(([, a], [, b]) => b - a).map(([tag, count]) => ({ tag, count }));

const groupedByYear: Record<string, typeof posts> = {};
sortedPosts.forEach((post) => { const y = formatYearMonth(post.data.date).year; if (!groupedByYear[y]) groupedByYear[y] = []; groupedByYear[y].push(post); });
const years = Object.keys(groupedByYear).sort((a, b) => Number(b) - Number(a));
---

<PageLayout title="Archive" description="Blog archive by date" tags={allTags}>
  <div class="mb-8">
    <h1 class="font-display text-2xl md:text-3xl font-bold uppercase tracking-wider mb-2" style={{ color: 'var(--text-primary)' }}>// ARCHIVE</h1>
    <p class="font-mono text-xs uppercase tracking-wider" style={{ color: 'var(--text-secondary)' }}>{sortedPosts.length} ARTICLES IN TOTAL</p>
  </div>
  <div class="space-y-8">
    {years.map((year) => (
      <div class="border" style={{ borderColor: 'var(--border-default)' }}>
        <div class="px-4 py-3 border-b" style={{ backgroundColor: 'var(--bg-surface)', borderColor: 'var(--border-default)' }}>
          <h2 class="font-display text-xl font-bold" style={{ color: 'var(--text-primary)' }}>{year} //</h2>
        </div>
        <div>
          {groupedByYear[year].map((post) => {
            const d = new Date(post.data.date);
            const m = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return (
              <a href={`/posts/${post.slug}/`} class="flex items-center gap-4 px-4 py-3 transition-colors hover:bg-[var(--bg-surface)] group border-b" style={{ borderColor: 'var(--border-default)' }}>
                <span class="font-mono text-xs shrink-0 w-16" style={{ color: 'var(--text-secondary)' }}>{m}-{day}</span>
                <span class="font-mono text-sm" style={{ color: 'var(--text-secondary)' }}>&#9500;&#9472;</span>
                <span class="text-sm transition-colors group-hover:text-[#A3E635] line-clamp-1" style={{ color: 'var(--text-primary)' }}>{post.data.title}</span>
              </a>
            );
          })}
        </div>
      </div>
    ))}
    {years.length === 0 && <div class="text-center py-16 border border-dashed" style={{ borderColor: 'var(--border-dim)' }}><p class="font-mono text-sm" style={{ color: 'var(--text-secondary)' }}>No posts yet.</p></div>}
  </div>
</PageLayout>
