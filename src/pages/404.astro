---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header';
import { ThemeProvider } from '../components/layout/ThemeProvider';
import Footer from '../components/layout/Footer.astro';
---

<BaseLayout title="404 - Not Found" description="Page not found">
  <ThemeProvider client:load><Header client:load /></ThemeProvider>
  <main class="flex-1 flex items-center justify-center px-4">
    <div class="border p-8 md:p-12 max-w-lg w-full" style={{ backgroundColor: 'var(--bg-surface)', borderColor: 'var(--border-default)' }}>
      <div class="flex items-center gap-2 mb-6 pb-4 border-b" style={{ borderColor: 'var(--border-default)' }}>
        <div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-red-500"></span><span class="w-3 h-3 rounded-full bg-yellow-500"></span><span class="w-3 h-3 rounded-full bg-green-500"></span></div>
        <span class="font-mono text-xs ml-2" style={{ color: 'var(--text-secondary)' }}>error</span>
      </div>
      <div class="font-mono">
        <h1 class="text-2xl md:text-3xl font-bold mb-2" style={{ color: '#A3E635' }}>ERROR 404</h1>
        <p class="text-sm mb-4" style={{ color: 'var(--text-secondary)' }}>FILE NOT FOUND</p>
        <div class="text-sm my-6 leading-relaxed" style={{ color: 'var(--text-secondary)' }}>
          <p class="mb-2"><span style={{ color: '#84CC16' }}>&gt;</span> The page you requested does not exist in this directory.</p>
          <p><span style={{ color: '#84CC16' }}>&gt;</span> Please check the URL or return to the homepage.</p>
        </div>
        <div class="flex gap-3 mt-8 flex-wrap">
          <a href="/" class="inline-flex items-center justify-center px-4 py-2 font-mono text-xs uppercase tracking-wider border transition-all duration-200" style={{ backgroundColor: '#A3E635', color: '#0A0A0A', borderColor: '#A3E635' }}>RETURN TO HOME</a>
          <a href="/posts/" class="inline-flex items-center justify-center px-4 py-2 font-mono text-xs uppercase tracking-wider border transition-all duration-200 hover:border-[#A3E635] hover:text-[#A3E635]" style={{ borderColor: 'var(--border-dim)', color: 'var(--text-secondary)', background: 'transparent' }}>BROWSE POSTS</a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
