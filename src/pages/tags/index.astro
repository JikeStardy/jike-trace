---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const tagCount: Record<string, number> = {};
posts.forEach((post) => post.data.tags.forEach((tag) => tagCount[tag] = (tagCount[tag] || 0) + 1));
const tags = Object.entries(tagCount).sort(([, a], [, b]) => b - a).map(([tag, count]) => ({ tag, count }));
---

<PageLayout title="Tags" description="Browse posts by tag">
  <div class="mb-8">
    <h1 class="font-display text-2xl md:text-3xl font-bold uppercase tracking-wider mb-2" style={{ color: 'var(--text-primary)' }}>// TAGS</h1>
    <p class="font-mono text-xs uppercase tracking-wider" style={{ color: 'var(--text-secondary)' }}>{tags.length} TAGS // {posts.length} ARTICLES</p>
  </div>
  {tags.length > 0 ? (
    <div class="flex flex-wrap gap-2">
      {tags.map(({ tag, count }) => (
        <a
          href={`/tags/${tag}/`}
          class="inline-flex items-center gap-1 font-mono text-xs uppercase tracking-wider px-3 py-2 border transition-all duration-200 hover:bg-[#A3E635] hover:text-[#0A0A0A] hover:border-[#A3E635]"
          style={{ borderColor: 'var(--border-default)', color: 'var(--text-primary)', background: 'transparent' }}
        >
          <span style={{ color: '#84CC16', opacity: 0.7 }}>[</span>
          <span>{tag}</span>
          <span style={{ color: '#84CC16', opacity: 0.7 }}>]</span>
          <span class="ml-0.5 opacity-50">x{count}</span>
        </a>
      ))}
    </div>
  ) : (
    <div class="text-center py-16 border border-dashed" style={{ borderColor: 'var(--border-dim)' }}><p class="font-mono text-sm" style={{ color: 'var(--text-secondary)' }}>No tags found.</p></div>
  )}

<style>
  a:hover span { color: inherit !important; opacity: 1 !important; }
</style>
</PageLayout>
