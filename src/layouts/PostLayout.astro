---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header';
import { ThemeProvider } from '../components/layout/ThemeProvider';
import Footer from '../components/layout/Footer.astro';
import PostMeta from '../components/post/PostMeta.astro';
import PostNav from '../components/post/PostNav.astro';
import type { CollectionEntry } from 'astro:content';
interface Props {
  post: CollectionEntry<'posts'>;
  prevPost?: { slug: string; title: string } | null;
  nextPost?: { slug: string; title: string } | null;
}
const { post, prevPost, nextPost } = Astro.props;
const { title, description, cover } = post.data;
const headings = post.rendered?.metadata?.headings || [];
const tocItems = headings.filter((h: any) => h.depth >= 2 && h.depth <= 3).map((h: any) => ({ id: h.slug, text: h.text, level: h.depth }));
---
<BaseLayout title={title} description={description}>
  <ThemeProvider client:load>
    <Header client:load />
  </ThemeProvider>
  <main class="flex-1 w-full max-w-6xl mx-auto px-4 md:px-8 py-8 md:py-12">
    <div class="flex gap-8">
      <article class="flex-1 min-w-0 max-w-reading mx-auto w-full">
        {cover && <img src={cover} alt={title} class="w-full mb-6 border" style={{ borderColor: 'var(--border-default)' }} />}
        <PostMeta post={post} />
        <div class="border-t my-6" style={{ borderColor: 'var(--border-dim)' }}></div>
        {tocItems.length > 0 && (
          <div class="lg:hidden mb-6 border p-4" style={{ backgroundColor: 'var(--bg-surface)', borderColor: 'var(--border-default)' }}>
            <h3 class="font-mono text-[11px] uppercase tracking-wider mb-2" style={{ color: 'var(--text-secondary)' }}>// TABLE OF CONTENTS</h3>
            <ul class="space-y-1">
              {tocItems.map((item) => (
                <li style={`padding-left: ${(item.level - 1) * 12}px`}>
                  <a href={`#${item.id}`} class="font-mono text-xs transition-colors hover:text-[#A3E635]" style={{ color: 'var(--text-secondary)' }}>{item.text}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
        <div class="prose-terminal"><slot /></div>
        <div class="font-mono text-xs text-center my-6" style={{ color: 'var(--text-secondary)' }} aria-hidden="true">// ============================ //</div>
        <PostNav prevPost={prevPost} nextPost={nextPost} />
      </article>
      {tocItems.length > 0 && (
        <nav class="hidden lg:block w-64 shrink-0">
          <div class="sticky top-20 border p-4" style={{ backgroundColor: 'var(--bg-surface)', borderColor: 'var(--border-default)' }}>
            <h3 class="font-mono text-[11px] uppercase tracking-wider mb-3" style={{ color: 'var(--text-secondary)' }}>// TABLE OF CONTENTS</h3>
            <ul class="space-y-1">
              {tocItems.map((item) => (
                <li style={`padding-left: ${(item.level - 1) * 12}px`}>
                  <a href={`#${item.id}`} class="block font-mono text-xs py-1 transition-colors hover:text-[#A3E635]" style={{ color: 'var(--text-secondary)' }}>{item.text}</a>
                </li>
              ))}
            </ul>
          </div>
        </nav>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>
